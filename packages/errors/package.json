{
  "name": "@deessejs/errors",
  "version": "1.0.0",
  "description": "TypeScript error handling library inspired by Python — function-based API, exception chaining, hierarchical inheritance",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "keywords": [
    "typescript",
    "errors",
    "exception",
    "error-handling",
    "exception-chaining",
    "hierarchical-errors",
    "python-style-errors",
    "custom-error-types",
    "nodejs",
    "npm-package"
  ],
  "author": "Nesalia Inc. <hello@nesalia.com>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.9.1",
    "eslint": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  }
}