{
  "name": "complete-package-template",
  "version": "1.0.0",
  "description": "TypeScript package template",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,md}\""
  },
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "turbo": "^2.9.15"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}